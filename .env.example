# Sample environment file for podman-compose. Copy to `.env` next to
# the compose file on each host, fill in the actual secrets, and
# `chmod 0600 .env`. Never commit `.env` itself — it's in .gitignore.
#
# Compose reads this automatically at `up` time and interpolates
# ${VAR} references in podman-compose.yaml. The compose declares
# every required key with the `${VAR:?msg}` form so a missing value
# fails fast at startup instead of silently breaking auth at runtime.

# Which `servers:` block in config.yaml to use ("production" / "development").
DS_SERVER=production

# Odoo JSON-RPC password for the user named in config.yaml's
# servers.<DS_SERVER>.username.
DS_PROD_PASSWORD=

# Gmail app-specific password for the SMTP sender named in
# servers.<DS_SERVER>.smtp-user.
DS_PROD_SMTP_PASSWORD=
